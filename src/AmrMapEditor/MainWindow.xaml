<Window x:Class="AmrMapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AmrMapEditor.Controls"
        Title="AMR Map Editor" Width="1480" Height="920"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="12"
        AllowDrop="True" Drop="OnDropFile"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
        Closing="OnClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="LineBrush" Color="#D5D9E0" />
        <SolidColorBrush x:Key="HintBrush" Color="#6B7280" />

        <Style x:Key="ToolButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="6,6,6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="VSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
        <DataTemplate x:Key="CheckItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Text}" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="열기" ToolTip="Ctrl+O · 파일을 창에 끌어놓아도 열림" Click="OnOpen" Margin="0,0,4,0" />
                <Button Content="저장" ToolTip="Ctrl+S" Click="OnSave" Margin="0,0,4,0" />
                <Button Content="다른 이름으로 저장" ToolTip="Ctrl+Shift+S" Click="OnSaveAs" />
                <Border Style="{StaticResource VSep}" />
                <Button x:Name="UndoButton" Content="실행 취소" ToolTip="Ctrl+Z" Click="OnUndo" Margin="0,0,4,0" />
                <Button x:Name="RedoButton" Content="다시 실행" ToolTip="Ctrl+Y" Click="OnRedo" />
                <Border Style="{StaticResource VSep}" />
                <Button Content="화면 맞춤" ToolTip="F" Click="OnFit" />
                <TextBlock Text="표시" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="DisplayModeCombo" Width="230" SelectedIndex="0" VerticalContentAlignment="Center"
                          SelectionChanged="OnDisplayModeChanged">
                    <ComboBoxItem Content="표준 (Free 흰색 · 장애물 검정)" Tag="Standard" />
                    <ComboBoxItem Content="확률값 컬러맵" Tag="Probability" />
                    <ComboBoxItem Content="분류 (확률값 전부 주황)" Tag="Category" />
                    <ComboBoxItem Content="원본 그레이 (GIMP와 동일)" Tag="Raw" />
                </ComboBox>
                <CheckBox x:Name="GridCheck" Content="픽셀 격자" IsChecked="True" VerticalAlignment="Center"
                          Margin="12,0,0,0" Click="OnGridToggle" />
            </StackPanel>
        </Border>

        <!-- 상태바 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusPos" Width="130" Text="-" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusWorld" Width="170" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusValue" Width="160" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusZoom" Width="70" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusMessage" /></StatusBarItem>
        </StatusBar>

        <!-- 좌측 도구 -->
        <Border DockPanel.Dock="Left" Width="122" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,8">
                    <RadioButton x:Name="ToolBrush" Style="{StaticResource ToolButton}" Tag="Brush" Content="브러시   B" IsChecked="True" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolEraser" Style="{StaticResource ToolButton}" Tag="Eraser" Content="지우개   E" ToolTip="Free(1)로 칠함" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolLine" Style="{StaticResource ToolButton}" Tag="Line" Content="직선   L" ToolTip="Shift: 0/45/90° 스냅" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" Tag="Rect" Content="사각형   R" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolFill" Style="{StaticResource ToolButton}" Tag="Fill" Content="채우기   G" ToolTip="같은 값으로 연결된 영역 채우기" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolPicker" Style="{StaticResource ToolButton}" Tag="Picker" Content="스포이드   I" Checked="OnToolChecked" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4,0,8" />
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" Tag="Select" Content="영역 선택   M" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolPolygon" Style="{StaticResource ToolButton}" Tag="Polygon" Content="폴리곤 선택   P" ToolTip="클릭으로 꼭짓점, 더블클릭/Enter로 완료, Backspace 되돌리기" Checked="OnToolChecked" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4,0,8" />
                    <RadioButton x:Name="ToolBlobPick" Style="{StaticResource ToolButton}" Tag="BlobPick" Content="객체 삭제   D" ToolTip="클릭한 장애물 덩어리 전체를 Free로" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolRestore" Style="{StaticResource ToolButton}" Tag="Restore" Content="복원 브러시   H" ToolTip="칠한 부분을 기준 맵 값으로 되돌림" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolWall" Style="{StaticResource ToolButton}" Tag="Wall" Content="벽 직선화   W" ToolTip="벽을 감싸듯 드래그 → 직선으로 다시 그림" Checked="OnToolChecked" />
                    <RadioButton x:Name="ToolPillar" Style="{StaticResource ToolButton}" Tag="Pillar" Content="기둥 정리   C" ToolTip="클릭한 덩어리를 사각형으로" Checked="OnToolChecked" />
                    <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                               Text="휠: 확대/축소&#x0a;가운데 버튼, Space+드래그: 이동&#x0a;[ ] 브러시 크기&#x0a;1 Free · 2 장애물 · 3 Unknown" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 우측 패널 -->
        <Border DockPanel.Dock="Right" Width="360" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <TabControl x:Name="SideTabs" Margin="4" Background="{StaticResource PanelBrush}">

                <!-- ═════════ 기본 ═════════ -->
                <TabItem Header="기본">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="파일">
                                <StackPanel>
                                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" Text="맵을 열어주세요. (Ctrl+O 또는 파일 끌어놓기)" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="해상도" Style="{StaticResource Label}" />
                                        <TextBox x:Name="ResolutionBox" Grid.Column="1" Text="0.05" TextChanged="OnResolutionChanged" />
                                        <TextBlock Grid.Column="2" Text="m/px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <CheckBox x:Name="HistoryCheck" Content="저장 시 변경 이력 남기기 (_history 폴더)" IsChecked="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="장애물 판정값">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="OccThresholdBox" Width="60" Text="128" TextChanged="OnThresholdChanged" />
                                        <TextBlock Text="이상을 장애물로 봄 (2~254)" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="노이즈 검출, 기준 맵 비교, 벽·기둥 정리에 공통으로 쓰입니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="그리기 값">
                                <StackPanel>
                                    <WrapPanel>
                                        <RadioButton x:Name="ValueObstacle" GroupName="DrawValue" Content="장애물 254" IsChecked="True" Margin="0,2,12,2" Checked="OnValueRadioChecked" />
                                        <RadioButton x:Name="ValueFree" GroupName="DrawValue" Content="Free 1" Margin="0,2,12,2" Checked="OnValueRadioChecked" />
                                        <RadioButton x:Name="ValueUnknown" GroupName="DrawValue" Content="Unknown 0" Margin="0,2,12,2" Checked="OnValueRadioChecked" />
                                        <RadioButton x:Name="ValueCustom" GroupName="DrawValue" Content="직접 입력" Margin="0,2,12,2" Checked="OnValueRadioChecked" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox x:Name="CustomValueBox" Width="70" Text="128" ToolTip="10진수, 0xFE, FEFEFE 형식" TextChanged="OnCustomValueChanged" />
                                        <Border x:Name="ValueSwatch" Width="34" Height="20" Margin="8,0,0,0" BorderBrush="#6B7280" BorderThickness="1" />
                                        <TextBlock x:Name="ValueText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="브러시 크기" Style="{StaticResource Label}" />
                                        <Slider x:Name="BrushSizeSlider" Grid.Column="1" Minimum="1" Maximum="60" Value="3"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                ValueChanged="OnBrushSizeChanged" />
                                        <TextBlock x:Name="BrushSizeText" Grid.Column="2" Text="3" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox x:Name="BrushRoundCheck" Content="원형 브러시" Margin="0,0,14,0" Click="OnBrushShapeChanged" />
                                        <CheckBox x:Name="RectFillCheck" Content="사각형 속 채우기" IsChecked="True" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="선택 영역">
                                <StackPanel>
                                    <TextBlock x:Name="SelectionText" TextWrapping="Wrap" Text="없음 (영역 선택 M, 폴리곤 선택 P)" />
                                    <CheckBox x:Name="ClipToSelectionCheck" Content="선택 영역 안에서만 편집" IsChecked="True" Margin="0,6,0,4" />
                                    <UniformGrid Columns="2">
                                        <Button Content="현재 값으로 채우기" Click="OnFillSelection" Margin="0,2,3,2" />
                                        <Button Content="선택 해제" ToolTip="Ctrl+D / Esc" Click="OnClearSelection" Margin="3,2,0,2" />
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="보호 영역">
                                <StackPanel>
                                    <ListBox x:Name="ProtectList" Height="90" DisplayMemberPath="Text" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="이름" Style="{StaticResource Label}" />
                                        <TextBox x:Name="ProtectNameBox" Grid.Column="1" Text="충전 스테이션" />
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <Button Content="선택 영역을 보호" Click="OnAddProtect" Margin="0,2,3,2" />
                                        <Button Content="목록에서 삭제" Click="OnRemoveProtect" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox x:Name="ProtectEnableCheck" Content="보호 적용" IsChecked="True" Margin="0,0,14,0" Click="OnProtectToggle" />
                                        <CheckBox x:Name="ProtectShowCheck" Content="화면 표시" IsChecked="True" Click="OnProtectToggle" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="충전·도킹 스테이션, 반사판 등 지우면 안 되는 곳. 모든 편집에서 제외되며 &lt;맵&gt;.protect.json에 저장됩니다." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════════ 업데이트 보정 ═════════ -->
                <TabItem Header="업데이트 보정">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
                                <TextBlock x:Name="GuideText" TextWrapping="Wrap" Text="1단계: 업데이트 전 기준 맵을 여세요." />
                            </Border>

                            <GroupBox Header="1. 기준 맵 (업데이트 전)">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="기준 맵 열기" Click="OnOpenReference" Margin="0,2,3,2" />
                                        <Button Content="기준 맵 닫기" Click="OnCloseReference" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock x:Name="RefFileText" Text="기준 맵 없음" TextWrapping="Wrap" Margin="0,4" />
                                    <ComboBox x:Name="OverlayModeCombo" SelectedIndex="1" SelectionChanged="OnOverlayModeChanged">
                                        <ComboBoxItem Content="표시 안 함" Tag="None" />
                                        <ComboBoxItem Content="변경점 (빨강 추가 · 파랑 삭제 · 노랑 기타)" Tag="Diff" />
                                        <ComboBoxItem Content="기준 맵 장애물 겹쳐보기 (청록)" Tag="Reference" />
                                    </ComboBox>
                                    <TextBlock x:Name="DiffStatsText" TextWrapping="Wrap" Margin="0,6,0,2" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2. 업데이트 영역">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateAreaText" TextWrapping="Wrap" Text="지정 안 함 (3~5단계는 맵 전체 대상)" />
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Content="선택 영역 추가" Click="OnAddUpdateArea" Margin="0,2,3,2" />
                                        <Button Content="마지막 삭제" Click="OnRemoveLastUpdateArea" Margin="3,2,3,2" />
                                        <Button Content="전체 삭제" Click="OnClearUpdateAreas" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Text="이번 업데이트에서 실제로 다시 스캔한 범위를 사각형(M)이나 폴리곤(P)으로 선택한 뒤 추가하세요. 여러 개 가능." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="3. 영역 밖 변경 복원">
                                <StackPanel>
                                    <TextBlock x:Name="OutsideText" TextWrapping="Wrap" Text="-" />
                                    <Button Content="영역 밖 변경을 기준 맵 값으로 되돌리기" Click="OnRevertOutside" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="4. 어긋남 확인 / 재정렬">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="탐색 범위" Style="{StaticResource Label}" />
                                        <TextBox x:Name="OffsetRadiusBox" Grid.Column="1" Text="20" />
                                        <TextBlock Grid.Column="2" Text="px" Style="{StaticResource Unit}" Margin="4,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="회전" Style="{StaticResource Label}" />
                                        <TextBox x:Name="OffsetAngleBox" Grid.Column="4" Text="1.0" />
                                        <TextBlock Grid.Column="5" Text="°" Style="{StaticResource Unit}" Margin="4,0,0,0" />
                                    </Grid>
                                    <Button Content="어긋남 추정" Click="OnEstimateOffset" />
                                    <TextBlock x:Name="OffsetText" TextWrapping="Wrap" Margin="0,4" Text="-" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="이동 dx" Style="{StaticResource Label}" />
                                        <TextBox x:Name="RealignDxBox" Grid.Column="1" Text="0" />
                                        <TextBlock Grid.Column="2" Text="dy" Style="{StaticResource Label}" Margin="10,2,8,2" />
                                        <TextBox x:Name="RealignDyBox" Grid.Column="3" Text="0" />
                                        <TextBlock Grid.Column="4" Text="px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <CheckBox x:Name="KeepRefCheck" Content="기준 맵 장애물은 지우지 않음" IsChecked="True" Margin="0,4" />
                                    <Button Content="업데이트분 이동 후 합성" Click="OnRealign" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="일정하게 수 px 밀려 있으면 업데이트 당시 위치 인식이 틀어진 것입니다. 이동은 정수 px만 적용하며, 회전이 크면 편집보다 재업데이트를 권장합니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="5. 이중 벽 정리">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="기존 벽과 거리" Style="{StaticResource Label}" />
                                        <TextBox x:Name="DupDistBox" Grid.Column="1" Text="10" TextChanged="OnUnitParamChanged" />
                                        <TextBlock x:Name="DupDistUnitText" Grid.Column="2" Text="px 이내" Style="{StaticResource Unit}" />
                                        <TextBlock Grid.Row="1" Text="최소 면적" Style="{StaticResource Label}" />
                                        <TextBox x:Name="DupMinAreaBox" Grid.Row="1" Grid.Column="1" Text="5" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                        <TextBlock Grid.Row="2" Text="주변 정리" Style="{StaticResource Label}" />
                                        <TextBox x:Name="DupExpandBox" Grid.Row="2" Grid.Column="1" Text="1" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <Button Content="이중 벽 후보 검출" Click="OnDetectDuplicates" />
                                    <TextBlock x:Name="DupCountText" Text="후보 없음" Margin="0,6,0,4" />
                                    <ListBox x:Name="DupList" Height="150" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnDupSelected" />
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Content="전체 체크" Click="OnCheckAllDup" Margin="0,2,3,2" />
                                        <Button Content="전체 해제" Click="OnUncheckAllDup" Margin="3,2,3,2" />
                                        <Button Content="체크 항목 복원" Click="OnRestoreDuplicates" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="새로 생긴 장애물 중 기존 벽 바로 옆에 붙은 덩어리입니다. 기존 벽을 남기고 새 쪽을 기준 맵 값으로 되돌립니다. 기존 벽 옆에 새로 설치한 설비도 잡히므로 확인 후 복원하세요." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="6. 변경 영역 확인">
                                <StackPanel>
                                    <Button Content="선택 영역을 기준 맵으로 복원" Click="OnRestoreSelection" />
                                    <Button Content="변경 영역 찾기" Click="OnFindDiffRegions" />
                                    <ListBox x:Name="DiffRegionList" Height="130" Margin="0,4,0,0"
                                             DisplayMemberPath="Text" SelectionChanged="OnDiffRegionSelected" />
                                    <TextBlock Style="{StaticResource Hint}" Text="남은 변경을 하나씩 확인합니다. 부분 수정은 복원 브러시(H)." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="7. 마무리">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="업데이트 영역 안의 캐스터 등 노이즈를 정리한 뒤 저장합니다. 저장 확인창에서 기준 맵 대비 변경량과 영역 밖 변경을 한 번 더 확인하세요." />
                                    <Button Content="맵 정리 탭으로 (노이즈 제거)" Click="OnGoCleanupTab" Margin="0,6,0,2" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════════ 맵 정리 ═════════ -->
                <TabItem x:Name="CleanupTab" Header="맵 정리">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="노이즈 객체 제거 (캐스터 · 얇은 기둥)">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="최대 면적" Style="{StaticResource Label}" />
                                        <TextBox x:Name="NoiseMaxAreaBox" Grid.Column="1" Text="60" TextChanged="OnUnitParamChanged" />
                                        <TextBlock x:Name="NoiseAreaUnitText" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                        <TextBlock Grid.Row="1" Text="최대 크기(긴 변)" Style="{StaticResource Label}" />
                                        <TextBox x:Name="NoiseMaxSideBox" Grid.Row="1" Grid.Column="1" Text="15" TextChanged="OnUnitParamChanged" />
                                        <TextBlock x:Name="NoiseSideUnitText" Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                        <TextBlock Grid.Row="2" Text="삭제 시 주변 정리" Style="{StaticResource Label}" />
                                        <TextBox x:Name="NoiseExpandBox" Grid.Row="2" Grid.Column="1" Text="1"
                                                 ToolTip="객체 주변 N px 안의 확률값(판정값 미만)도 Free로 정리" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <CheckBox x:Name="NoiseInSelectionCheck" Content="선택 영역 안에서만 검출" Margin="0,6,0,4" />
                                    <Button Content="후보 검출" Click="OnDetectNoise" />
                                    <TextBlock x:Name="CandidateCountText" Text="후보 없음" Margin="0,6,0,4" />
                                    <ListBox x:Name="CandidateList" Height="170" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnCandidateSelected" />
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Content="전체 체크" Click="OnCheckAllCandidates" Margin="0,2,3,2" />
                                        <Button Content="전체 해제" Click="OnUncheckAllCandidates" Margin="3,2,3,2" />
                                        <Button Content="체크 항목 삭제" Click="OnDeleteCandidates" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Text="실제 고정 기둥은 위치 인식 기준점이 될 수 있으니 확인 후 삭제하세요. 하나씩은 객체 삭제 도구(D)." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="맵 주축 (벽 방향)">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AxisText" Text="계산 전" VerticalAlignment="Center" Width="170" />
                                        <Button Content="다시 계산" Click="OnEstimateAxis" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="스냅 허용 각도" Style="{StaticResource Label}" />
                                        <TextBox x:Name="SnapTolBox" Width="50" Text="3" />
                                        <TextBlock Text="°" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="벽 직선화·기둥 정리가 이 각도(±90°) 근처면 정확히 맞춥니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="벽 직선화">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="두께" Style="{StaticResource Label}" />
                                        <TextBox x:Name="WallThicknessBox" Width="50" Text="0" />
                                        <TextBlock Text="px (0 = 자동)" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WallSnapCheck" Content="주축에 스냅" IsChecked="True" Margin="0,4" />
                                    <Button Content="선택 영역에 적용" Click="OnStraightenSelection" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="벽 직선화 도구(W)로 벽 하나를 감싸듯 드래그하면 바로 적용됩니다. 영역 안의 끊긴 구간도 이어서 그립니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="기둥 정리">
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="PillarFillCheck" Content="속 채우기" IsChecked="True" Margin="0,0,14,0" />
                                        <CheckBox x:Name="PillarSnapCheck" Content="주축에 스냅" IsChecked="True" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="기둥 정리 도구(C)로 기둥을 클릭하면 덩어리를 감싸는 사각형으로 바꿉니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="벽 끊김 후보">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="최대 틈" Style="{StaticResource Label}" />
                                        <TextBox x:Name="GapMaxBox" Text="12" Grid.Column="1" TextChanged="OnUnitParamChanged" />
                                        <TextBlock x:Name="GapMaxUnitText" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                        <TextBlock Grid.Row="1" Text="양쪽 벽 최소 길이" Style="{StaticResource Label}" />
                                        <TextBox x:Name="GapMinRunBox" Grid.Row="1" Grid.Column="1" Text="10" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <CheckBox x:Name="GapInSelectionCheck" Content="선택 영역 안에서만 검출" Margin="0,6,0,4" />
                                    <Button Content="끊김 후보 검출" Click="OnDetectGaps" />
                                    <TextBlock x:Name="GapCountText" Text="후보 없음" Margin="0,6,0,4" />
                                    <ListBox x:Name="GapList" Height="130" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnGapSelected" />
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Content="전체 체크" Click="OnCheckAllGaps" Margin="0,2,3,2" />
                                        <Button Content="전체 해제" Click="OnUncheckAllGaps" Margin="3,2,3,2" />
                                        <Button Content="체크 항목 연결" Click="OnFillGaps" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="수평·수직 벽만 검출합니다 (기울어진 맵은 기울기 보정 후). 출입구도 후보가 될 수 있어 기본은 체크 해제 상태입니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="확률값 정리">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="FreeMaxBox" Width="50" Text="50" />
                                        <TextBlock Text="이하 → Free, 판정값 이상 → 장애물" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                    <Button Content="선택 영역 정리 (없으면 전체)" Click="OnCleanProbability" />
                                    <TextBlock Style="{StaticResource Hint}" Text="그 사이 값은 유지합니다. 위치 인식이 확률값을 쓰는지 확인 전에는 필요한 영역만 적용하세요." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="외곽 정리">
                                <StackPanel>
                                    <Button Content="선택 영역 밖을 Unknown으로" Click="OnClearOutside" />
                                    <TextBlock Style="{StaticResource Hint}" Text="건물 외곽을 폴리곤(P)으로 선택한 뒤 실행하면 창문·출입구 너머로 찍힌 산란점이 정리됩니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="기울기 보정 (신규 맵 전용)">
                                <StackPanel>
                                    <Button Content="주축 기준으로 맵 회전" Click="OnDeskew" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="맵 크기와 좌표계가 바뀝니다. 스테이션·경로 티칭 전에만 사용하세요. 저장 시 yaml origin을 갱신합니다. 기준 맵 비교 중에는 사용할 수 없습니다." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════════ 도면 ═════════ -->
                <TabItem Header="도면">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="DXF 도면">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Button Content="도면 열기" Click="OnOpenDxf" Margin="0,2,3,2" />
                                        <Button Content="도면 닫기" Click="OnCloseDxf" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock x:Name="DxfFileText" Text="도면 없음" TextWrapping="Wrap" Margin="0,4" />
                                    <CheckBox x:Name="DxfShowCheck" Content="도면 표시" IsChecked="True" Click="OnDxfShowToggle" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="레이어">
                                <StackPanel>
                                    <ListBox x:Name="DxfLayerList" Height="160">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="{Binding Text}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <Button Content="전체 표시" Click="OnDxfLayersAll" Margin="0,2,3,2" />
                                        <Button Content="전체 숨김" Click="OnDxfLayersNone" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Text="벽·기둥 레이어만 남기면 비교가 쉽습니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="정렬">
                                <StackPanel>
                                    <TextBlock x:Name="DxfUnitText" Text="단위: -" Margin="0,0,0,4" />
                                    <CheckBox x:Name="DxfScaleLockCheck" Content="축척 고정 (도면 단위 ÷ 맵 해상도)" IsChecked="True" Margin="0,0,0,4" />
                                    <UniformGrid Columns="2">
                                        <Button Content="2점 정렬 시작" Click="OnDxfAlignStart" Margin="0,2,3,2" />
                                        <Button Content="맵 중앙에 배치" Click="OnDxfFit" Margin="3,2,0,2" />
                                    </UniformGrid>
                                    <TextBlock x:Name="DxfAlignText" TextWrapping="Wrap" Margin="0,4" Text="-" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="이동 X" Style="{StaticResource Label}" />
                                        <TextBox x:Name="DxfOffsetXBox" Grid.Column="1" Text="0" />
                                        <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource Label}" Margin="10,2,8,2" />
                                        <TextBox x:Name="DxfOffsetYBox" Grid.Column="3" Text="0" />
                                        <TextBlock Grid.Row="1" Text="회전 °" Style="{StaticResource Label}" />
                                        <TextBox x:Name="DxfRotationBox" Grid.Row="1" Grid.Column="1" Text="0" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="축척" Style="{StaticResource Label}" Margin="10,2,8,2" />
                                        <TextBox x:Name="DxfScaleBox" Grid.Row="1" Grid.Column="3" Text="1" ToolTip="도면 1단위당 px" />
                                    </Grid>
                                    <Button Content="값 적용" Click="OnDxfApply" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="2점 정렬: 도면의 점 A → 맵의 같은 위치 → 도면의 점 B → 맵의 같은 위치 순서로 클릭. 도면 점은 가까운 꼭짓점에 붙습니다. 정렬 결과는 &lt;맵&gt;.dxf.json에 저장됩니다." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 맵 -->
        <ctl:MapView x:Name="MapViewer" />
    </DockPanel>
</Window>
