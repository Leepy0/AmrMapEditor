<Window x:Class="AmrMapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AmrMapEditor.Controls"
        Title="AMR Map Editor" Width="1480" Height="920" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        Foreground="{StaticResource LabelBrush}" Background="{StaticResource InspectorBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDropFile"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource ChromeLineBrush}" />
        </Style>
        <Style x:Key="RailDivider" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Background" Value="{StaticResource ChromeLineBrush}" />
        </Style>
        <Style x:Key="Pane" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="PaneHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="4,4,0,6" />
        </Style>
        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="EmptyBody" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="EmptyIcon" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 옵션 행: 라벨 | 입력 | 단위 -->
        <Style x:Key="OptionRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="OptionUnit" TargetType="TextBlock" BasedOn="{StaticResource Unit}">
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <DataTemplate x:Key="ProtectItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Region}" Foreground="{StaticResource SecondaryLabelBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LayerItemTemplate">
            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TertiaryLabelBrush}" Margin="6,0,0,0" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═════════ 툴바 ═════════ -->
        <Border DockPanel.Dock="Top" Height="50" Padding="10,0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnOpen" ToolTip="열기  Ctrl+O&#x0a;파일을 창에 끌어놓아도 열립니다.">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Open}" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Click="OnSave" ToolTip="저장  Ctrl+S">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Save}" />
                    </Button>
                    <Button x:Name="SaveAsButton" Style="{StaticResource IconButton}" Click="OnSaveAs" ToolTip="다른 이름으로 저장  Ctrl+Shift+S">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.SaveAs}" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="OnUndo" ToolTip="실행 취소  Ctrl+Z">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Undo}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="OnRedo" ToolTip="다시 실행  Ctrl+Y">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Redo}" />
                    </Button>
                </StackPanel>

                <!-- 표시 방식 -->
                <Border Grid.Column="1" Style="{StaticResource SegmentTrack}" VerticalAlignment="Center">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="DisplayStandard" Style="{StaticResource SegmentRadio}" GroupName="Display" Tag="Standard"
                                     Content="표준" IsChecked="True" MinWidth="64" Checked="OnDisplayModeChanged"
                                     ToolTip="Free 흰색 · 장애물 검정 · Unknown 청회색" />
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Display" Tag="Probability"
                                     Content="확률" MinWidth="64" Checked="OnDisplayModeChanged"
                                     ToolTip="확률값(2~253)을 컬러맵으로 표시" />
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Display" Tag="Category"
                                     Content="분류" MinWidth="64" Checked="OnDisplayModeChanged"
                                     ToolTip="확률값을 모두 주황으로 표시해 한눈에 구분" />
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Display" Tag="Raw"
                                     Content="원본" MinWidth="64" Checked="OnDisplayModeChanged"
                                     ToolTip="저장된 그레이 값 그대로 (GIMP와 동일)" />
                    </UniformGrid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="GridCheck" Style="{StaticResource IconToggle}" IsChecked="True" Click="OnGridToggle"
                                  ToolTip="픽셀 격자&#x0a;1200% 이상 확대하면 표시됩니다.">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Grid}" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Click="OnFit" ToolTip="화면 맞춤  F">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Fit}" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource IconButton}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000"
                            ToolTip="휠  확대 / 축소&#x0a;가운데 버튼 · Space+드래그  화면 이동&#x0a;F  화면 맞춤&#x0a;[ ]  브러시 크기&#x0a;1 · 2 · 3  Free · 장애물 · Unknown&#x0a;Esc  선택 해제 / 진행 중인 작업 취소&#x0a;Ctrl+D  선택 해제">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Help}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ 상태바 ═════════ -->
        <Border DockPanel.Dock="Bottom" Height="26" Padding="12,0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="0,1,0,0"
                TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource SecondaryLabelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource LabelBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="StatusValue" MinWidth="140" />
                    <TextBlock x:Name="StatusPos" MinWidth="110" Text="-" />
                    <TextBlock x:Name="StatusWorld" MinWidth="140" />
                    <TextBlock x:Name="StatusZoom" MinWidth="44" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ 좌측 도구 ═════════ -->
        <Border DockPanel.Dock="Left" Width="56" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 현재 그리기 값 -->
                <Button x:Name="RailSwatchButton" DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Width="38" Height="38"
                        Margin="0,6,0,10" HorizontalAlignment="Center" Click="OnRailSwatchClick">
                    <Border x:Name="RailSwatch" Width="22" Height="22" CornerRadius="6" Background="#000000"
                            BorderBrush="#40000000" BorderThickness="1" />
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <StackPanel Margin="0,8" HorizontalAlignment="Center">
                        <RadioButton x:Name="ToolBrush" Style="{StaticResource ToolRadio}" Tag="Brush" IsChecked="True" Checked="OnToolChecked"
                                     ToolTip="브러시  B&#x0a;그리기 값으로 칠합니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Brush}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolEraser" Style="{StaticResource ToolRadio}" Tag="Eraser" Checked="OnToolChecked"
                                     ToolTip="지우개  E&#x0a;Free(1)로 칠합니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Eraser}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolLine" Style="{StaticResource ToolRadio}" Tag="Line" Checked="OnToolChecked"
                                     ToolTip="직선  L&#x0a;드래그. Shift를 누르면 0/45/90°로 맞춥니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Line}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolRect" Style="{StaticResource ToolRadio}" Tag="Rect" Checked="OnToolChecked"
                                     ToolTip="사각형  R&#x0a;드래그. 속 채우기는 편집 탭에서 설정.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Rect}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolFill" Style="{StaticResource ToolRadio}" Tag="Fill" Checked="OnToolChecked"
                                     ToolTip="채우기  G&#x0a;같은 값으로 연결된 영역을 채웁니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Fill}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolPicker" Style="{StaticResource ToolRadio}" Tag="Picker" Checked="OnToolChecked"
                                     ToolTip="스포이드  I&#x0a;클릭한 픽셀 값을 그리기 값으로.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Picker}" />
                        </RadioButton>

                        <Border Style="{StaticResource RailDivider}" />
                        <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolRadio}" Tag="Select" Checked="OnToolChecked"
                                     ToolTip="영역 선택  M&#x0a;드래그. 클릭하면 해제.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Select}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolPolygon" Style="{StaticResource ToolRadio}" Tag="Polygon" Checked="OnToolChecked"
                                     ToolTip="폴리곤 선택  P&#x0a;클릭으로 꼭짓점, 더블클릭·Enter로 완료, Backspace 되돌리기.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Polygon}" />
                        </RadioButton>

                        <Border Style="{StaticResource RailDivider}" />
                        <RadioButton x:Name="ToolBlobPick" Style="{StaticResource ToolRadio}" Tag="BlobPick" Checked="OnToolChecked"
                                     ToolTip="객체 삭제  D&#x0a;클릭한 장애물 덩어리 전체를 Free로.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.BlobDelete}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolRestore" Style="{StaticResource ToolRadio}" Tag="Restore" Checked="OnToolChecked"
                                     ToolTip="복원 브러시  H&#x0a;칠한 곳을 기준 맵 값으로 되돌립니다. (기준 맵 필요)">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Restore}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolWall" Style="{StaticResource ToolRadio}" Tag="Wall" Checked="OnToolChecked"
                                     ToolTip="벽 직선화  W&#x0a;벽 하나를 감싸듯 드래그하면 직선으로 다시 그립니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Wall}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolPillar" Style="{StaticResource ToolRadio}" Tag="Pillar" Checked="OnToolChecked"
                                     ToolTip="기둥 정리  C&#x0a;클릭한 덩어리를 사각형으로 바꿉니다.">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Pillar}" />
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═════════ 우측 인스펙터 ═════════ -->
        <Border DockPanel.Dock="Right" Width="324" Background="{StaticResource InspectorBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,12,12,10">
                    <Border Style="{StaticResource SegmentTrack}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="SegEdit" Style="{StaticResource SegmentRadio}" GroupName="Pane" Content="편집" IsChecked="True" />
                            <RadioButton x:Name="SegUpdate" Style="{StaticResource SegmentRadio}" GroupName="Pane" Content="업데이트"
                                         ToolTip="업데이트 전 기준 맵과 비교해 보정" />
                            <RadioButton x:Name="SegClean" Style="{StaticResource SegmentRadio}" GroupName="Pane" Content="정리"
                                         ToolTip="노이즈 · 벽 · 기둥 정리" />
                            <RadioButton x:Name="SegDxf" Style="{StaticResource SegmentRadio}" GroupName="Pane" Content="도면"
                                         ToolTip="DXF 도면 겹쳐보기" />
                        </UniformGrid>
                    </Border>
                </Border>

                <!-- 작업 대상: 선택 영역이 있으면 편집 · 검출 · 정리는 그 안에서만 -->
                <Border x:Name="ScopeBar" DockPanel.Dock="Top" Margin="12,0,12,10" MinHeight="34" Padding="10,0,4,0" CornerRadius="8"
                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                        ToolTip="작업 대상&#x0a;선택 영역이 있으면 편집 · 후보 찾기 · 정리가 그 안에서만 실행됩니다.&#x0a;없으면 맵 전체가 대상입니다.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ScopeIcon" Style="{StaticResource Icon}" Data="{StaticResource I.Select}" Stretch="Uniform"
                              Width="15" Height="15" Stroke="{StaticResource SecondaryLabelBrush}" />
                        <TextBlock x:Name="ScopeText" Grid.Column="1" Margin="8,0" Text="대상  맵 전체" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryLabelBrush}" />
                        <Button x:Name="ScopeClearButton" Grid.Column="2" Style="{StaticResource SmallIconButton}" Click="OnClearSelection"
                                ToolTip="선택 해제  Esc" Visibility="Collapsed">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="InspectorBody">

                    <!-- ═════════════════ 편집 ═════════════════ -->
                    <ScrollViewer Style="{StaticResource Pane}" Visibility="{Binding IsChecked, ElementName=SegEdit, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="12,0,12,12">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Map}" Stroke="{StaticResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FileNameText" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" Text="열린 맵 없음" />
                                        <TextBlock x:Name="FileMetaText" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Ctrl+O 또는 파일을 끌어놓으세요" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource PaneHeader}" Text="그리기 값" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <UniformGrid Columns="4" Margin="0,0,-6,0">
                                        <RadioButton x:Name="ValueFree" Style="{StaticResource SwatchRadio}" Background="{StaticResource ValueFreeBrush}"
                                                     Content="Free" Checked="OnValueRadioChecked" ToolTip="Free · 1   단축키 1" />
                                        <RadioButton x:Name="ValueObstacle" Style="{StaticResource SwatchRadio}" Background="{StaticResource ValueObstacleBrush}"
                                                     Content="장애물" IsChecked="True" Checked="OnValueRadioChecked" ToolTip="장애물 · 254   단축키 2" />
                                        <RadioButton x:Name="ValueUnknown" Style="{StaticResource SwatchRadio}" Background="{StaticResource ValueUnknownBrush}"
                                                     Content="Unknown" Checked="OnValueRadioChecked" ToolTip="Unknown · 0   단축키 3" />
                                        <RadioButton x:Name="ValueCustom" Style="{StaticResource SwatchRadio}" Background="{StaticResource ValueCustomBrush}"
                                                     Content="직접" Checked="OnValueRadioChecked" ToolTip="원하는 값 입력 (254, 0xFE, FEFEFE)&#x0a;스포이드(I)로 고른 값도 여기로 들어옵니다." />
                                    </UniformGrid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ValueSwatch" Width="14" Height="14" CornerRadius="4" BorderBrush="#40000000" BorderThickness="1" />
                                        <TextBlock x:Name="ValueText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                        <TextBox x:Name="CustomValueBox" Grid.Column="2" Style="{StaticResource NumberBox}" Width="72" Text="128"
                                                 ToolTip="10진수, 0xFE, FEFEFE 형식" TextChanged="OnCustomValueChanged"
                                                 Visibility="{Binding IsChecked, ElementName=ValueCustom, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource PaneHeader}" Text="브러시" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="크기" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                                        <Slider x:Name="BrushSizeSlider" Grid.Column="1" Minimum="1" Maximum="60" Value="3"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                ValueChanged="OnBrushSizeChanged" ToolTip="[ ] 키로 조절" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" MinWidth="46" Margin="10,0,0,0">
                                            <TextBlock x:Name="BrushSizeText" Text="3" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="px" Style="{StaticResource Unit}" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Hairline}" />
                                    <CheckBox x:Name="BrushRoundCheck" Style="{StaticResource Switch}" Content="원형 브러시" Click="OnBrushShapeChanged" />
                                    <CheckBox x:Name="RectFillCheck" Style="{StaticResource Switch}" Content="사각형 속 채우기" IsChecked="True" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource PaneHeader}" Text="선택 영역" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="ClipToSelectionCheck" Style="{StaticResource Switch}" Content="선택 영역 안에서만 편집" IsChecked="True"
                                              ToolTip="끄면 선택 영역이 있어도 브러시 등 일반 편집이 맵 전체에 적용됩니다." />
                                    <Button x:Name="FillSelectionButton" Margin="0,10,0,0" Click="OnFillSelection" IsEnabled="False"
                                            ToolTip="선택 영역 전체를 현재 그리기 값으로 채웁니다.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Fill}" />
                                            <TextBlock Text="그리기 값으로 채우기" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="4,4,0,6">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="보호 영역" />
                                <ContentControl Style="{StaticResource InfoTip}"
                                                ToolTip="충전 · 도킹 스테이션, 반사판처럼 지우면 안 되는 곳.&#x0a;모든 편집과 후보 찾기에서 제외되며 &lt;맵&gt;.protect.json에 저장됩니다." />
                            </StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ListBox x:Name="ProtectList" MaxHeight="130" Visibility="Collapsed" ItemTemplate="{StaticResource ProtectItemTemplate}" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProtectNameBox" Text="충전 스테이션" ToolTip="추가할 보호 영역 이름" />
                                        <Button x:Name="AddProtectButton" Grid.Column="1" Style="{StaticResource SmallIconButton}" Width="28" Height="26" Margin="6,0,0,0"
                                                Foreground="{StaticResource AccentBrush}" Click="OnAddProtect" IsEnabled="False"
                                                ToolTip="선택 영역을 보호 영역으로 추가">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Plus}" />
                                        </Button>
                                        <Button x:Name="RemoveProtectButton" Grid.Column="2" Style="{StaticResource SmallIconButton}" Width="28" Height="26"
                                                Click="OnRemoveProtect" ToolTip="목록에서 고른 보호 영역 삭제">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Minus}" />
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource Hairline}" />
                                    <CheckBox x:Name="ProtectEnableCheck" Style="{StaticResource Switch}" Content="편집에서 제외" IsChecked="True" Click="OnProtectToggle" />
                                    <CheckBox x:Name="ProtectShowCheck" Style="{StaticResource Switch}" Content="화면에 표시" IsChecked="True" Margin="0,6,0,0" Click="OnProtectToggle" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource PaneHeader}" Text="맵 설정" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="해상도" Style="{StaticResource RowLabel}" />
                                        <TextBox x:Name="ResolutionBox" Grid.Column="1" Style="{StaticResource NumberBox}" Text="0.05" TextChanged="OnResolutionChanged"
                                                 ToolTip="yaml이 있으면 자동으로 읽습니다." />
                                        <TextBlock Grid.Column="2" Text="m/px" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <Border Style="{StaticResource Hairline}" Margin="0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="장애물 기준값" Style="{StaticResource RowLabel}" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="이 값 이상을 장애물로 봅니다 (2~254).&#x0a;후보 찾기, 기준 맵 비교, 벽 · 기둥 정리에 공통으로 쓰입니다." />
                                        </StackPanel>
                                        <TextBox x:Name="OccThresholdBox" Grid.Column="1" Style="{StaticResource NumberBox}" Text="128" TextChanged="OnThresholdChanged" />
                                        <TextBlock Grid.Column="2" Text="이상" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <Border Style="{StaticResource Hairline}" Margin="0,8" />
                                    <CheckBox x:Name="HistoryCheck" Style="{StaticResource Switch}" Content="저장할 때 변경 이력 남기기" IsChecked="True"
                                              ToolTip="맵 옆 _history 폴더에 변경 내용을 기록합니다." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════════════════ 업데이트 ═════════════════ -->
                    <ScrollViewer Style="{StaticResource Pane}" Visibility="{Binding IsChecked, ElementName=SegUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="12,0,12,12">

                            <!-- 기준 맵 없음 -->
                            <StackPanel x:Name="RefEmptyPanel" Margin="16,48,16,0">
                                <Border Style="{StaticResource EmptyIcon}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Layers}" Stretch="Uniform" Width="26" Height="26"
                                          Stroke="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="기준 맵과 비교" />
                                <TextBlock Style="{StaticResource EmptyBody}" Text="업데이트 전 맵을 열면 달라진 곳을 찾아&#x0a;단계별로 보정할 수 있어요." />
                                <Button Style="{StaticResource PrimaryButton}" Content="기준 맵 열기" Click="OnOpenReference"
                                        HorizontalAlignment="Center" Padding="20,0" Height="32" Margin="0,18,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="RefStepsPanel" Visibility="Collapsed">
                                <!-- 1. 기준 맵 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource StepBadge}" Background="{StaticResource GreenBrush}">
                                                <TextBlock Style="{StaticResource StepNumber}" Text="✓" Foreground="#FFFFFF" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="기준 맵" />
                                                <TextBlock x:Name="RefFileText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Click="OnCloseReference" ToolTip="기준 맵 닫기">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" />
                                            </Button>
                                        </Grid>
                                        <Border Style="{StaticResource SegmentTrack}" Margin="0,12,0,0">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="OverlayNone" Style="{StaticResource SegmentRadio}" GroupName="Overlay" Tag="None"
                                                             Content="끄기" Checked="OnOverlayModeChanged" />
                                                <RadioButton x:Name="OverlayDiff" Style="{StaticResource SegmentRadio}" GroupName="Overlay" Tag="Diff"
                                                             Content="변경점" IsChecked="True" Checked="OnOverlayModeChanged"
                                                             ToolTip="빨강 추가 · 파랑 삭제 · 노랑 기타 값 변화" />
                                                <RadioButton x:Name="OverlayReference" Style="{StaticResource SegmentRadio}" GroupName="Overlay" Tag="Reference"
                                                             Content="겹쳐보기" Checked="OnOverlayModeChanged"
                                                             ToolTip="기준 맵 장애물을 청록색으로 겹쳐 표시" />
                                            </UniformGrid>
                                        </Border>
                                        <UniformGrid Columns="3" Margin="2,12,0,0">
                                            <StackPanel ToolTip="새로 생긴 장애물">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiffAddedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="추가" Style="{StaticResource Caption}" Margin="5,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="DiffAddedText" Text="0" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel ToolTip="사라진 장애물">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiffRemovedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="삭제" Style="{StaticResource Caption}" Margin="5,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="DiffRemovedText" Text="0" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel ToolTip="장애물 여부는 같고 값만 바뀐 픽셀">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DiffOtherBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="기타" Style="{StaticResource Caption}" Margin="5,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="DiffOtherText" Text="0" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 업데이트 영역 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step2Badge" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="Step2Text" Style="{StaticResource StepNumber}" Text="2" />
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="업데이트 영역" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="이번에 실제로 다시 스캔한 범위입니다.&#x0a;사각형(M)이나 폴리곤(P)으로 선택한 뒤 추가하세요. 여러 개 가능.&#x0a;지정하지 않으면 3~5단계는 맵 전체가 대상입니다." />
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateAreaText" Style="{StaticResource Caption}" Margin="32,4,0,0" />
                                        <Grid Margin="32,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AddAreaButton" Click="OnAddUpdateArea" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Plus}" />
                                                    <TextBlock Text="선택 영역 추가" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Width="28" Height="28" Margin="6,0,0,0"
                                                    Click="OnRemoveLastUpdateArea" ToolTip="마지막 영역 빼기">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Undo}" />
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Width="28" Height="28"
                                                    Click="OnClearUpdateAreas" ToolTip="모두 지우기">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. 영역 밖 되돌리기 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step3Badge" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="Step3Text" Style="{StaticResource StepNumber}" Text="3" />
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="영역 밖 되돌리기" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="업데이트 영역 밖에서 기준 맵과 달라진 픽셀을 기준 맵 값으로 되돌립니다." />
                                        </StackPanel>
                                        <TextBlock x:Name="OutsideText" Style="{StaticResource Caption}" Margin="32,4,0,0" />
                                        <Button x:Name="RevertOutsideButton" Margin="32,10,0,0" Click="OnRevertOutside" IsEnabled="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Restore}" />
                                                <TextBlock Text="기준 맵 값으로 되돌리기" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 어긋남 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step4Badge" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="Step4Text" Style="{StaticResource StepNumber}" Text="4" />
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="어긋남 보정" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="업데이트분이 일정하게 몇 px 밀려 있으면 업데이트 당시 위치 인식이 틀어진 것입니다.&#x0a;이동은 정수 px만 적용하며, 회전이 크면 편집보다 재업데이트를 권장합니다." />
                                        </StackPanel>
                                        <StackPanel Margin="32,10,0,0">
                                            <Button Click="OnEstimateOffset">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Target}" />
                                                    <TextBlock Text="어긋남 추정" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="OffsetText" Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="17" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="이동" Style="{StaticResource RowLabel}" />
                                                <TextBlock Grid.Column="1" Text="x" Style="{StaticResource Unit}" Margin="0,0,5,0" />
                                                <TextBox x:Name="RealignDxBox" Grid.Column="2" Style="{StaticResource NumberBox}" Width="48" Text="0" />
                                                <TextBlock Grid.Column="3" Text="y" Style="{StaticResource Unit}" Margin="10,0,5,0" />
                                                <TextBox x:Name="RealignDyBox" Grid.Column="4" Style="{StaticResource NumberBox}" Width="48" Text="0" />
                                                <TextBlock Grid.Column="5" Text="px" Style="{StaticResource Unit}" />
                                            </Grid>
                                            <CheckBox x:Name="KeepRefCheck" Style="{StaticResource Switch}" Content="기준 맵 장애물 유지" IsChecked="True" Margin="0,8,0,0"
                                                      ToolTip="이동 후 합칠 때 기준 맵의 장애물은 지우지 않습니다." />
                                            <Button Margin="0,8,0,0" Click="OnRealign" ToolTip="업데이트분을 위 값만큼 옮겨 기준 맵과 합칩니다.">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Move}" />
                                                    <TextBlock Text="옮겨서 합치기" />
                                                </StackPanel>
                                            </Button>
                                            <Expander Style="{StaticResource Disclosure}" Header="옵션" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <Grid Style="{StaticResource OptionRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="탐색 범위" Style="{StaticResource RowLabel}" />
                                                        <TextBox x:Name="OffsetRadiusBox" Grid.Column="1" Style="{StaticResource NumberBox}" Text="20" />
                                                        <TextBlock Grid.Column="2" Text="px" Style="{StaticResource Unit}" MinWidth="24" />
                                                    </Grid>
                                                    <Grid Style="{StaticResource OptionRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="회전 범위" Style="{StaticResource RowLabel}" />
                                                        <TextBox x:Name="OffsetAngleBox" Grid.Column="1" Style="{StaticResource NumberBox}" Text="1.0" />
                                                        <TextBlock Grid.Column="2" Text="°" Style="{StaticResource Unit}" MinWidth="24" />
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 이중 벽 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Step5Badge" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="Step5Text" Style="{StaticResource StepNumber}" Text="5" />
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="이중 벽 정리" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="새로 생긴 장애물 중 기존 벽 바로 옆에 붙은 덩어리입니다.&#x0a;기존 벽을 남기고 새 쪽을 기준 맵 값으로 되돌립니다.&#x0a;벽 옆에 새로 설치한 설비도 잡히니 확인 후 복원하세요." />
                                        </StackPanel>
                                        <StackPanel Margin="32,10,0,0">
                                            <Button Click="OnDetectDuplicates">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Search}" />
                                                    <TextBlock Text="후보 찾기" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel x:Name="DupResults" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Grid Margin="8,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="DupAllCheck" Click="OnToggleAllDup" ToolTip="모두 체크 / 해제" />
                                                    <TextBlock x:Name="DupCountText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                </Grid>
                                                <ListBox x:Name="DupList" MaxHeight="180" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnDupSelected" />
                                                <Button Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="OnRestoreDuplicates">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Restore}" />
                                                        <TextBlock Text="체크한 항목 복원" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Expander Style="{StaticResource Disclosure}" Header="옵션" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <Grid Style="{StaticResource OptionRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="기존 벽과 거리" Style="{StaticResource RowLabel}" />
                                                        <TextBox x:Name="DupDistBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="52" Text="10" TextChanged="OnUnitParamChanged" />
                                                        <TextBlock x:Name="DupDistUnitText" Grid.Column="2" Text="px 이내" Style="{StaticResource OptionUnit}" />
                                                    </Grid>
                                                    <Grid Style="{StaticResource OptionRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="최소 면적" Style="{StaticResource RowLabel}" />
                                                        <TextBox x:Name="DupMinAreaBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="52" Text="5" />
                                                        <TextBlock Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                                    </Grid>
                                                    <Grid Style="{StaticResource OptionRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="주변 정리" Style="{StaticResource RowLabel}" />
                                                        <TextBox x:Name="DupExpandBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="52" Text="1"
                                                                 ToolTip="복원할 때 덩어리 주변 N px까지 함께 되돌립니다." />
                                                        <TextBlock Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 6. 남은 변경 -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource StepBadge}">
                                                <TextBlock Style="{StaticResource StepNumber}" Text="6" />
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="남은 변경 확인" />
                                            <ContentControl Style="{StaticResource InfoTip}"
                                                            ToolTip="남은 변경을 하나씩 확인합니다. 목록을 누르면 그 위치로 이동합니다.&#x0a;부분 수정은 복원 브러시(H)를 쓰세요." />
                                        </StackPanel>
                                        <StackPanel Margin="32,10,0,0">
                                            <UniformGrid Columns="2">
                                                <Button Click="OnFindDiffRegions" Margin="0,0,3,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Search}" />
                                                        <TextBlock Text="변경 찾기" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RestoreSelectionButton" Click="OnRestoreSelection" Margin="3,0,0,0" IsEnabled="False"
                                                        ToolTip="선택 영역을 기준 맵 값으로 되돌립니다.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Restore}" />
                                                        <TextBlock Text="선택 복원" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <ListBox x:Name="DiffRegionList" MaxHeight="180" Margin="0,8,0,0" Visibility="Collapsed"
                                                     ItemTemplate="{StaticResource RegionItemTemplate}" SelectionChanged="OnDiffRegionSelected" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource LinkButton}" Click="OnGoCleanupTab" HorizontalAlignment="Center" Margin="0,2,0,8"
                                        ToolTip="캐스터 등 노이즈를 정리한 뒤 저장하세요.&#x0a;저장 확인창에서 기준 맵 대비 변경량을 한 번 더 보여줍니다.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="마무리: 노이즈 정리" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Arrow}" Stretch="Uniform" Width="12" Height="12" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════════════════ 정리 ═════════════════ -->
                    <ScrollViewer Style="{StaticResource Pane}" Visibility="{Binding IsChecked, ElementName=SegClean, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="12,0,12,12">

                            <!-- 노이즈 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="노이즈 제거" />
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="캐스터 · 얇은 기둥 같은 작은 장애물 덩어리를 찾습니다.&#x0a;실제 고정 기둥은 위치 인식 기준점일 수 있으니 확인 후 삭제하세요.&#x0a;하나씩 지울 때는 객체 삭제 도구(D)." />
                                    </StackPanel>
                                    <Button Margin="0,10,0,0" Click="OnDetectNoise">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Search}" />
                                            <TextBlock Text="후보 찾기" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="NoiseResults" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid Margin="8,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="NoiseAllCheck" Click="OnToggleAllCandidates" ToolTip="모두 체크 / 해제" />
                                            <TextBlock x:Name="CandidateCountText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                        </Grid>
                                        <ListBox x:Name="CandidateList" MaxHeight="200" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnCandidateSelected" />
                                        <Button Style="{StaticResource DestructiveButton}" Margin="0,8,0,0" Click="OnDeleteCandidates">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Trash}" />
                                                <TextBlock Text="체크한 항목 삭제" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Expander Style="{StaticResource Disclosure}" Header="옵션" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="최대 면적" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="NoiseMaxAreaBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="60" TextChanged="OnUnitParamChanged" />
                                                <TextBlock x:Name="NoiseAreaUnitText" Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="최대 길이" Style="{StaticResource RowLabel}" ToolTip="덩어리의 긴 변" />
                                                <TextBox x:Name="NoiseMaxSideBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="15" TextChanged="OnUnitParamChanged" />
                                                <TextBlock x:Name="NoiseSideUnitText" Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="주변 정리" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="NoiseExpandBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="1"
                                                         ToolTip="삭제할 때 객체 주변 N px 안의 확률값(기준값 미만)도 Free로 정리합니다." />
                                                <TextBlock Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- 벽 끊김 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="벽 끊김 잇기" />
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="수평 · 수직 벽의 짧은 틈을 찾습니다 (기울어진 맵은 기울기 보정 후).&#x0a;출입구도 후보가 될 수 있어 처음에는 모두 체크 해제 상태입니다." />
                                    </StackPanel>
                                    <Button Margin="0,10,0,0" Click="OnDetectGaps">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Search}" />
                                            <TextBlock Text="후보 찾기" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="GapResults" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid Margin="8,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="GapAllCheck" Click="OnToggleAllGaps" ToolTip="모두 체크 / 해제" />
                                            <TextBlock x:Name="GapCountText" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                        </Grid>
                                        <ListBox x:Name="GapList" MaxHeight="180" ItemTemplate="{StaticResource CheckItemTemplate}" SelectionChanged="OnGapSelected" />
                                        <Button Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="OnFillGaps">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Check}" />
                                                <TextBlock Text="체크한 틈 잇기" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Expander Style="{StaticResource Disclosure}" Header="옵션" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="최대 틈" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="GapMaxBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="12" TextChanged="OnUnitParamChanged" />
                                                <TextBlock x:Name="GapMaxUnitText" Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="양쪽 벽 최소 길이" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="GapMinRunBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="10" />
                                                <TextBlock Grid.Column="2" Text="px" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- 벽 · 기둥 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="벽 · 기둥 반듯하게" />
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="벽 직선화 도구(W): 벽 하나를 감싸듯 드래그하면 직선으로 다시 그립니다. 끊긴 구간도 이어서 그립니다.&#x0a;기둥 정리 도구(C): 기둥을 클릭하면 감싸는 사각형으로 바꿉니다.&#x0a;맵 주축(벽 방향)과 허용 각도 이내면 정확히 맞춥니다." />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="맵 주축" Style="{StaticResource RowLabel}" />
                                        <TextBlock x:Name="AxisText" Grid.Column="1" Style="{StaticResource Caption}" Text="계산 전" />
                                        <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Margin="4,0,-4,0" Click="OnEstimateAxis" ToolTip="다시 계산">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Rotate}" />
                                        </Button>
                                    </Grid>
                                    <Button x:Name="StraightenButton" Margin="0,8,0,0" Click="OnStraightenSelection" IsEnabled="False"
                                            ToolTip="선택 영역 안의 벽을 직선으로 다시 그립니다.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Wall}" />
                                            <TextBlock Text="선택 영역 직선화" />
                                        </StackPanel>
                                    </Button>
                                    <Expander Style="{StaticResource Disclosure}" Header="옵션" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="벽 두께" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="WallThicknessBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="0" />
                                                <TextBlock Grid.Column="2" Text="px (0 = 자동)" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                            <Grid Style="{StaticResource OptionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="주축 허용 각도" Style="{StaticResource RowLabel}" />
                                                <TextBox x:Name="SnapTolBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="3" />
                                                <TextBlock Grid.Column="2" Text="°" Style="{StaticResource OptionUnit}" />
                                            </Grid>
                                            <CheckBox x:Name="WallSnapCheck" Style="{StaticResource Switch}" Content="벽을 주축에 맞춤" IsChecked="True" Margin="0,4,0,0" />
                                            <CheckBox x:Name="PillarSnapCheck" Style="{StaticResource Switch}" Content="기둥을 주축에 맞춤" IsChecked="True" Margin="0,6,0,0" />
                                            <CheckBox x:Name="PillarFillCheck" Style="{StaticResource Switch}" Content="기둥 속 채우기" IsChecked="True" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- 확률값 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="확률값 정리" />
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="기준값 이하는 Free, 장애물 기준값 이상은 장애물로 바꾸고 그 사이 값은 유지합니다.&#x0a;위치 인식이 확률값을 쓰는지 확인 전에는 필요한 영역만 선택해 적용하세요." />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Free로 바꿀 값" Style="{StaticResource RowLabel}" />
                                        <TextBox x:Name="FreeMaxBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="56" Text="50" />
                                        <TextBlock Grid.Column="2" Text="이하" Style="{StaticResource Unit}" />
                                    </Grid>
                                    <Button Margin="0,10,0,0" Click="OnCleanProbability">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Sparkle}" />
                                            <TextBlock Text="정리" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 외곽 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="외곽 정리" />
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="건물 외곽을 폴리곤(P)으로 선택한 뒤 실행하면&#x0a;창문 · 출입구 너머로 찍힌 산란점을 Unknown으로 정리합니다." />
                                    </StackPanel>
                                    <Button x:Name="ClearOutsideButton" Margin="0,10,0,0" Click="OnClearOutside" IsEnabled="False"
                                            ToolTip="선택 영역 밖을 모두 Unknown(0)으로 바꿉니다.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Select}" />
                                            <TextBlock Text="선택 영역 밖 지우기" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 기울기 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="기울기 보정" />
                                        <Border Background="#FFF4E5" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="신규 맵 전용" FontSize="11" Foreground="#C77700" />
                                        </Border>
                                        <ContentControl Style="{StaticResource InfoTip}"
                                                        ToolTip="맵을 주축 각도만큼 회전해 벽을 수평 · 수직으로 맞춥니다.&#x0a;맵 크기와 좌표계가 바뀌므로 스테이션 · 경로 티칭 전에만 사용하세요.&#x0a;저장 시 yaml origin을 갱신합니다. 기준 맵 비교 중에는 쓸 수 없습니다." />
                                    </StackPanel>
                                    <Button x:Name="DeskewButton" Margin="0,10,0,0" Click="OnDeskew">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Rotate}" />
                                            <TextBlock Text="주축에 맞춰 회전" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════════════════ 도면 ═════════════════ -->
                    <ScrollViewer Style="{StaticResource Pane}" Visibility="{Binding IsChecked, ElementName=SegDxf, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="12,0,12,12">

                            <StackPanel x:Name="DxfEmptyPanel" Margin="16,48,16,0">
                                <Border Style="{StaticResource EmptyIcon}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Map}" Stretch="Uniform" Width="26" Height="26"
                                          Stroke="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="도면 겹쳐보기" />
                                <TextBlock Style="{StaticResource EmptyBody}" Text="DXF 도면을 맵 위에 겹쳐&#x0a;벽 위치를 비교할 수 있어요." />
                                <Button Style="{StaticResource PrimaryButton}" Content="도면 열기" Click="OnOpenDxf"
                                        HorizontalAlignment="Center" Padding="20,0" Height="32" Margin="0,18,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="DxfContentPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#FFF1E6" VerticalAlignment="Top">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Map}" Stroke="#F97316" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DxfFileText" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="DxfUnitText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Click="OnCloseDxf" VerticalAlignment="Top"
                                                    ToolTip="도면 닫기 (맵과의 연결도 해제)">
                                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" />
                                            </Button>
                                        </Grid>
                                        <Border Style="{StaticResource Hairline}" />
                                        <CheckBox x:Name="DxfShowCheck" Style="{StaticResource Switch}" Content="도면 표시" IsChecked="True" Click="OnDxfShowToggle" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="4,4,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="레이어" />
                                        <ContentControl Style="{StaticResource InfoTip}" ToolTip="벽 · 기둥 레이어만 남기면 비교가 쉽습니다." />
                                    </StackPanel>
                                    <CheckBox x:Name="DxfLayersAllCheck" Grid.Column="1" Content="모두" FontSize="11.5" Click="OnToggleAllLayers" />
                                </Grid>
                                <Border Style="{StaticResource Card}" Padding="4">
                                    <ListBox x:Name="DxfLayerList" MaxHeight="220" BorderThickness="0" Padding="0"
                                             ItemTemplate="{StaticResource LayerItemTemplate}" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="4,4,0,6">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="위치 맞추기" />
                                    <ContentControl Style="{StaticResource InfoTip}"
                                                    ToolTip="2점 정렬: 도면의 점 A → 맵의 같은 위치 → 도면의 점 B → 맵의 같은 위치 순서로 클릭.&#x0a;도면 점은 가까운 꼭짓점에 붙습니다. 결과는 &lt;맵&gt;.dxf.json에 저장됩니다." />
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Click="OnDxfAlignStart">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Target}" />
                                                <TextBlock Text="2점 정렬 시작" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="DxfAlignText" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
                                        <Button Margin="0,6,0,0" Click="OnDxfFit">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource SmallIcon}" Data="{StaticResource I.Fit}" />
                                                <TextBlock Text="맵 중앙에 배치" />
                                            </StackPanel>
                                        </Button>
                                        <Border Style="{StaticResource Hairline}" />
                                        <CheckBox x:Name="DxfScaleLockCheck" Style="{StaticResource Switch}" Content="축척 고정" IsChecked="True"
                                                  ToolTip="축척을 '도면 단위 ÷ 맵 해상도'로 고정하고 이동 · 회전만 맞춥니다." />
                                        <Expander Style="{StaticResource Disclosure}" Header="직접 입력" Margin="0,10,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="X" Style="{StaticResource RowLabel}" Margin="0,0,8,0" />
                                                    <TextBox x:Name="DxfOffsetXBox" Grid.Column="1" TextAlignment="Right" Text="0" ToolTip="이동 X (px)" />
                                                    <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource RowLabel}" Margin="12,0,8,0" />
                                                    <TextBox x:Name="DxfOffsetYBox" Grid.Column="3" TextAlignment="Right" Text="0" ToolTip="이동 Y (px)" />
                                                    <TextBlock Grid.Row="1" Text="회전" Style="{StaticResource RowLabel}" Margin="0,8,8,0" />
                                                    <TextBox x:Name="DxfRotationBox" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Text="0" Margin="0,8,0,0" ToolTip="회전 (°)" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="축척" Style="{StaticResource RowLabel}" Margin="12,8,8,0" />
                                                    <TextBox x:Name="DxfScaleBox" Grid.Row="1" Grid.Column="3" TextAlignment="Right" Text="1" Margin="0,8,0,0" ToolTip="도면 1단위당 px" />
                                                </Grid>
                                                <Button Content="적용" Margin="0,10,0,0" Click="OnDxfApply" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═════════ 맵 ═════════ -->
        <Grid Background="{StaticResource CanvasBrush}">
            <ctl:MapView x:Name="MapViewer" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource I.Map}" Stretch="Uniform" Width="56" Height="56" Stroke="#8E8E93" StrokeThickness="1.5"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" />
                <TextBlock Text="맵을 열어 시작하세요" Foreground="#F2F2F7" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="PGM 파일을 이 창에 끌어놓거나 Ctrl+O" Foreground="#8E8E93" FontSize="12.5" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Content="맵 열기" Click="OnOpen" HorizontalAlignment="Center"
                        Padding="22,0" Height="32" Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
