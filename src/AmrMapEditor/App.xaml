<Application x:Class="AmrMapEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═════════ 색상 (Apple 시스템 색 기준) ═════════ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3EEFF" />
        <SolidColorBrush x:Key="LabelBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="TertiaryLabelBrush" Color="#AEAEB2" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D6" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#F7F7F9" />
        <SolidColorBrush x:Key="ChromeLineBrush" Color="#DCDCE0" />
        <SolidColorBrush x:Key="InspectorBrush" Color="#F2F2F7" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardLineBrush" Color="#E8E8ED" />
        <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
        <SolidColorBrush x:Key="PressedBrush" Color="#1F000000" />
        <SolidColorBrush x:Key="SegmentTrackBrush" Color="#E6E6EB" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="GreenBrush" Color="#34C759" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF3B30" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500" />

        <!-- 맵 표시 색과 동일 (MapRender) -->
        <SolidColorBrush x:Key="DiffAddedBrush" Color="#FF1E1E" />
        <SolidColorBrush x:Key="DiffRemovedBrush" Color="#146EFF" />
        <SolidColorBrush x:Key="DiffOtherBrush" Color="#FFD200" />
        <SolidColorBrush x:Key="ValueObstacleBrush" Color="#000000" />
        <SolidColorBrush x:Key="ValueFreeBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ValueUnknownBrush" Color="#B4BECB" />
        <LinearGradientBrush x:Key="ValueCustomBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#000000" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000" />
        <DropShadowEffect x:Key="KnobShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.30" Color="#000000" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

