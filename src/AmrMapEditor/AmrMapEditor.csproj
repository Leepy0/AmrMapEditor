<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AmrMapEditor</RootNamespace>
    <AssemblyName>AmrMapEditor</AssemblyName>
    <Version>0.7.0</Version>
    <Product>AMR Map Editor</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 배포 exe에 넣을 위성 리소스 언어 (자체 포함 크기 줄이기) -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <!-- CI가 -p:BuildChannel=release|dev 로 넘김. 그 외는 로컬 빌드 (자동 업데이트 안 함) -->
    <BuildChannel Condition="'$(BuildChannel)' == ''">local</BuildChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildChannel" Value="$(BuildChannel)" />
  </ItemGroup>

</Project>
